digraph schema_forge_etl {
  rankdir=LR;
  node [shape=box, style=rounded];

  raw       [card="document-intake@1.0.0"];
  extract   [card="field-extractor@1.0.0"];
  normalize [card="field-normalizer@1.0.0"];
  validate  [card="schema-gate@1.1.0"];
  repair    [card="record-repairer@1.0.0"];
  store     [card="record-store@1.0.0"];
  publish   [card="dataset-publisher@1.0.0"];

  raw -> extract;
  extract -> normalize [in="fields"];
  normalize -> validate [in="candidate"];
  validate -> repair [label="invalid", style=dashed, out="violations", in="violations"];
  repair -> normalize [in="repaired"];
  validate -> store [label="valid", out="accepted"];
  store -> publish;
}
