// Attractor-compatible DOT, generated by DarkPrint (doc 1 §0.1.1).
// Blueprint digest: sha256:644482b6a7c7d2fb1169097a819f5c29a17c4d6214cb5ff20042f4d2c1a5590f
digraph adversarial_consensus_line {
  goal="Two agents solve the same task from opposite temperatures, then a consensus node negotiates a single answer — re-opening the debate when they clash.";
  label="Adversarial Consensus Line";

  __start [label="start", shape=Mdiamond];
  task [label="Task Intake", shape=parallelogram, prompt="Take the next request off the `task-queue` source and check it against the `task-request@1` schema before anything else; reject a request that does not match and stop, rather than forwarding a half-filled brief the rest of the line has to guess at. Stamp the accepted request with a fresh run id and attach to it the reference to the acceptance-criteria set this run will be judged against. Emit the result on `request` as one self-contained brief carrying the goal, the constraints and that criteria reference. You are the only step that reads the queue, so anything you drop or fail to copy across is gone for the remainder of the run.", card="task-intake@1.0.0"];
  plan [label="Task Decomposer", shape=box, prompt="Read the stamped brief on `request` and split its goal into an ordered list of sub-tasks, each small enough that one pass can finish it and each stating its own done condition. Emit at most six; when the goal will not fit in six, merge the smallest adjacent steps instead of emitting a seventh. Onto every sub-task copy the slice of the run's criteria reference that sub-task answers to, so each one can be judged on its own without re-reading the whole brief. Emit the ordered list on `subtasks`, and decompose the same brief the same way every time: two solvers work this plan in parallel, and their answers are only comparable if they started from an identical plan.", card="task-decomposer@1.0.0"];
  solverA [label="Conservative Solver", shape=box, prompt="You are handed an ordered list of sub-tasks on `brief`, each carrying its own done condition. Work all of them the safe way: take the reading that needs the fewest assumptions, prefer the established approach over the ingenious one, and add no requirement the brief does not state. Emit one proposal on `proposal` that answers every sub-task in the brief's order, and list beside it each assumption you had to make and the evidence behind each choice, keyed to the sub-task it belongs to. A competing proposal will be scored against yours on those grounds, so an unexplained choice counts as no choice. When a sub-task cannot be answered without a guess you are not willing to defend, say so on that sub-task instead of inventing one.", card="conservative-solver@1.0.0"];
  solverB [label="Exploratory Solver", shape=box, prompt="You are handed an ordered list of sub-tasks on `brief`, each carrying its own done condition. Work all of them from the angle that is not the obvious one: interrogate what the brief takes for granted, and follow the approach that pays off most if the interrogation holds. Emit one proposal on `proposal` that answers every sub-task in the brief's order, and for each point where you left the cautious reading behind, state the departure, what it buys and what it costs if you turn out to be wrong. A proposal that lands exactly where the careful route would have landed has wasted its pass — but do not manufacture a difference where the brief admits only one reading; record that the sub-task offered no room instead.", card="exploratory-solver@1.0.0"];
  vote [label="Weighted Vote", shape=diamond, prompt="Score each of the competing proposals you are handed, weighting every one by the reputation of the validator behind it — or by the scoring rubric supplied for this run, when there is one, which replaces the default weighting entirely. Emit the highest scorer on `chosen`, tagged with the margin it won by, and settle an exact tie in favour of the more conservative proposal rather than picking arbitrarily. Emit every proposal with its score and the weights that produced it on `tally`: the disagreement is the part worth reading, so never report the winner on its own.", card="weighted-vote@1.0.0"];
  verify [label="Acceptance Verifier", shape=box, prompt="Check the finished artefact you are handed against every criterion in the set registered as `acceptance-criteria@1`, one at a time, using the supporting material supplied alongside it wherever a criterion calls for evidence. Emit the artefact unchanged on `accepted` only once every criterion has cleared. When one is missed, judge which kind of miss it is: if the work is simply wrong, record the criterion and stop the run; if the candidates it was chosen from answered the brief in genuinely different ways, emit that on `conflict` so the choice can be reopened. `conflict` is for real disagreement only — never use it as a second failure exit.", card="acceptance-verifier@1.1.0"];
  reopen [label="Bounded Retry", shape=parallelogram, prompt="You are handed the failure signal of a step that has just gone wrong, carrying the error that caused it. Re-issue that step's attempt, waiting 800 ms before the first retry and doubling the wait on every retry after it. Emit each re-issued attempt on `attempt` with its attempt number, so whoever receives it can tell a retry from a first run. Give up after three retries: emit the error from the final attempt on `last_error` and issue nothing further — do not keep circling, and do not swallow the error.", max_retries=3, card="bounded-retry@1.0.0"];
  deliver [label="Result Delivery", shape=parallelogram, prompt="Take the signed-off result you are handed, write it to `run-artifacts` exactly as the verifier released it, and close the run. Write the decision trace alongside it — which node produced what, and what each one decided — so the delivery can be reconstructed later without re-running the line. Emit nothing onward: this is the last step of the run, so deliver only what you were actually handed and alter none of it.", card="result-delivery@1.0.0"];
  __exit [label="exit", shape=Msquare];

  __start -> task;
  task -> plan;
  plan -> solverA;
  plan -> solverB;
  solverA -> vote;
  solverB -> vote;
  vote -> verify;
  verify -> deliver [label="pass"];
  verify -> reopen [label="conflict"];
  reopen -> vote [label="re-vote"];
  deliver -> __exit;
}
