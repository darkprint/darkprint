digraph frontline_triage {
  rankdir=LR;
  node [shape=box, style=rounded];

  ticket      [card="event-intake@1.0.0"];
  classify    [card="intent-router@1.0.0"];
  autoresolve [card="resolution-composer@1.0.0"];
  kb          [card="kb-resolver@1.0.0"];
  qa          [card="reply-qa-check@1.0.0"];
  send        [card="reply-dispatch@1.0.0"];
  escalate    [card="confidence-escalation@1.0.0"];

  ticket -> classify;
  classify -> autoresolve [label="simple"];
  classify -> kb [label="lookup"];
  kb -> autoresolve;
  autoresolve -> qa;
  qa -> send     [label="confident"];
  qa -> escalate [label="low conf.", style=dashed, out="confidence", in="verdict"];
}
