// Attractor-compatible DOT, generated by DarkPrint (doc 1 §0.1.1).
// Blueprint digest: sha256:dbef1e27b43359b7016f66ae48991b48dfd145d136d2ff917578594e68392f3b
digraph nightly_data_janitor {
  goal="An unattended overnight cleanup line: extract deltas, normalize, validate against schema, and publish — repairing dirty rows in place.";
  label="Nightly Data Janitor";

  __start [label="start", shape=Mdiamond];
  raw [label="Delta Intake", shape=parallelogram, prompt="Read the `last_successful_run` watermark and work out the window this run has to sweep: it starts at the watermark and ends at the moment you run. Emit that window on `window` as an explicit start and end timestamp in UTC, together with the watermark value you derived them from. Never clip the window back to the nominal 24 hours when the watermark is older than that — a night that did not run has to widen the next window, not quietly lose its rows. If there is no watermark at all, emit a window covering the last 24 hours and mark it as a cold start so the reader knows the bound was assumed rather than recorded.", card="delta-intake@1.0.0"];
  extract [label="Delta Extractor", shape=parallelogram, prompt="Query the warehouse for every row whose change timestamp falls inside the window you receive on `window`, reading in pages of 5000 rows ordered by that timestamp so paging stays stable across the run. Emit the rows on `rows` over a fixed set of columns, in the order the warehouse returned them, with no reshaping or filtering of your own. Stop at 50000 rows and report the timestamp you stopped at, so a runaway night comes back truncated and resumable instead of pulling the whole history. Issue reads only: you must not write, update or delete anything in the warehouse, whatever the window turns out to contain.", card="delta-extractor@1.0.0"];
  normalize [label="Field Normalizer", shape=box, prompt="Take the field values arriving on `fields` — a JSON object per document or a row per delta, whichever form you are handed — and coerce them onto the canonical record shape: dates to ISO-8601, quantities to the canonical unit, enumerated values to their canonical casing, and every spelling of emptiness (`\"\"`, `-`, `N/A`, `unknown`) to a real null. Resolve ambiguous date and number formats as `en-GB`, so `03/04` is the third of April. Emit exactly one record per input row on `record`, carrying that row's identity through untouched; coerce values, and never invent one to fill a gap. A record arriving on `repaired` is one you have already seen, mended elsewhere: normalize it the same way and emit it the same way, but stop after a record has come back three times and drop it instead of sending it round again.", llm_model="claude-haiku-4-5", max_retries=3, card="field-normalizer@1.0.0"];
  validate [label="Schema Gate", shape=box, prompt="Check the normalized record you are handed against the schema registered as `schema-registry://warehouse-record@3`. Emit it byte-for-byte unchanged on `accepted` only when it conforms exactly — a field the schema does not name is a failure, not a tolerance. When it does not conform, emit one entry per breach on `violations`, each naming the field and the specific constraint it broke: the repair step works from the constraint and can do nothing with a bare rejection.", llm_model="claude-haiku-4-5", card="schema-gate@1.0.0"];
  repair [label="Record Repairer", shape=box, prompt="Work through the entries on `violations` one at a time. Each entry names one field and the specific constraint that field broke, and that constraint is your whole brief for what the value has to become — rewrite that field and leave every other field of the record exactly as you received it. Emit the mended record on `repaired`, whole: never emit a partial record, and never delete a field or blank it out to make a violation go away, because a silently dropped field is worse than a rejected one. When a violation cannot be mended from what the record itself contains — the value is missing rather than malformed — leave the field alone and note the reason on the record, so the next pass fails on something true instead of on your guess.", llm_model="claude-sonnet-5", max_retries=3, card="record-repairer@1.0.0"];
  store [label="Record Store", shape=parallelogram, prompt="Upsert the records arriving on `records` into the target table in batches of at most 500 rows, matching an existing row on `record_id` and inserting when no row matches. Commit each batch before you start the next one, so an interruption leaves whole batches written rather than half of one. Emit a commit receipt on `stored` naming the keys written, how many rows were inserted against how many updated, and the boundary of the last batch that committed. You are done when every record handed to you appears in that receipt exactly once; if a batch fails to commit, stop there and report the boundary it failed at rather than skipping past it.", card="record-store@1.0.0"];
  publish [label="Warehouse Publisher", shape=parallelogram, prompt="Read the commit receipt on `dataset`, refresh the downstream views over the target table, and only then advance the watermark to the end of the window this run swept. Keep that order: if the refresh fails, leave the watermark exactly where it was, so the next night re-sweeps the same window instead of stepping over it. Post one digest to the `nightly-ops` channel giving the night's counts — rows cleaned, rows repaired, rows quarantined — and stay silent when nothing was repaired and nothing was quarantined, because a message every night trains people to ignore the one that matters. The run is done when the watermark has moved and, on any night that was not clean, the digest has been posted.", card="warehouse-publisher@1.0.0"];
  __exit [label="exit", shape=Msquare];

  __start -> raw;
  raw -> extract;
  extract -> normalize;
  normalize -> validate;
  validate -> repair [label="invalid"];
  repair -> normalize;
  validate -> store [label="valid"];
  store -> publish;
  publish -> __exit;
}
