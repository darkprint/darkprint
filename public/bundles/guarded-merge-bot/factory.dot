// Attractor-compatible DOT, generated by DarkPrint (doc 1 §0.1.1).
// Blueprint digest: sha256:3e12918b0be5bfb932011edc8b5f3ff96d448cab3620d87f4c4a36869d3484fa
digraph guarded_merge_bot {
  goal="An agent line triages the PR and drafts the review, iterating with the test runner until the suite is green. A maintainer approves before the merge lands.";
  label="Guarded Merge Bot";

  __start [label="start", shape=Mdiamond];
  pr [label="PR Intake", shape=parallelogram, prompt="A pull-request webhook event has just fired on the repository you watch. Accept it only when its action is `opened`, `synchronize` or `ready_for_review`, and drop it without emitting anything when the pull request is still a draft. For an accepted event, assemble one JSON payload on `pull_request` carrying the base ref, the head ref, the changed-file list with per-file diff stats, the unified diff itself, and the title and body the author wrote as their declared intent. You are done the moment that payload is emitted, do not read the repository beyond the two refs the event names, and do not form an opinion about the change.", card="pr-intake@1.0.0"];
  triage [label="Diff Triager", shape=box, prompt="You are handed a pull-request payload with the base and head refs, the changed-file list and the unified diff. Read the diff hunk by hunk and put every changed file in exactly one band: `high` for public interfaces, authentication, data migrations and concurrency, `mechanical` for renames, formatting and generated output, `normal` for everything else, with one line of reasoning per file naming the hunk that decided it. Then work out the blast radius: which modules import what the diff touched, and which test suites cover them. Emit a single JSON record on `triage` holding the per-file bands with their reasons, the blast radius, and the list of suites to run. Triage at most sixty files; if the diff is larger, take the sixty that touch the most call sites and state in the record how many you left out.", llm_model="claude-sonnet-5", card="diff-triager@1.0.0"];
  draft [label="Review Drafter", shape=box, prompt="You are handed a triage record listing, per changed file, a risk band, the reasoning behind it, and the test suites the change is expected to move. Write a review a maintainer can act on: one comment per finding, each anchored to a file path and a line number, each stating what is wrong and what would fix it. Cover every file banded `high` before you write about anything else, and say nothing at all about files banded `mechanical`. A `failures` signal is attached only when the previous run of the suites came back red; when it is there, open the review with those failing cases and tie each one to the finding it belongs to. Emit the finished review as Markdown on `review` with at most twenty-five comments, and repeat the suite names the record selected so whoever runs them next knows what to execute.", llm_model="claude-sonnet-5", card="review-drafter@1.0.0"];
  tests [label="Test Runner", shape=box, prompt="Read the drafted review you are handed, take the test suites it names, and run exactly those against the pull request's head ref, no more, no fewer. Give the whole run thirty minutes; a suite still executing when that expires counts as a failure, not as a pass. Emit `green` on `result` when every suite passes and `red` otherwise, carrying the failing-case count so the branch downstream can read the outcome without opening the write-up. Emit that write-up on `report`: suite names, durations, every failing case with its assertion and stack trace, and the coverage delta against the base ref. Do not edit the code, do not re-run a failing suite hoping for a different answer, and do not judge whether the change deserves to be merged.", llm_model="claude-haiku-4-5", max_retries=3, card="test-runner@1.0.0"];
  gate [label="Maintainer Approval", shape=hexagon, prompt="Hold the run here and put the test report you are handed in front of a maintainer who holds write access to this repository. Show them the suite results, the durations and the coverage delta as they were reported, and let them open the drafted review themselves if they want the findings; do not summarise the change for them and do not recommend an outcome. Wait for exactly one such maintainer to approve or reject, there is no timeout, no default verdict and no substitute approver without write access. Emit their verdict and nothing else on `approval`, and on a rejection emit nothing at all, so the step after you has nothing to act on.", card="maintainer-approval@1.0.0"];
  merge [label="Merge Executor", shape=parallelogram, prompt="You act on one thing only: the approval signal you are handed. If it is anything other than an approval, stop and emit nothing. On an approval, merge the pull request's head into its base as a single squashed commit whose message is the pull-request title and body, then delete the source branch. If the base has moved and the squash does not apply cleanly, abort, leave the base untouched, leave the source branch in place, and report the conflict instead of resolving it yourself. Emit the resulting commit on `merge_commit` with its SHA, its parents and the branch it landed on. Use the repository write token scoped to this repository alone, and never push to any ref other than the base branch the approval names.", card="merge-executor@1.0.0"];
  __exit [label="exit", shape=Msquare];

  __start -> pr;
  pr -> triage;
  triage -> draft;
  draft -> tests;
  tests -> draft [label="red"];
  tests -> gate [label="green"];
  gate -> merge [label="human approve"];
  merge -> __exit;
}
