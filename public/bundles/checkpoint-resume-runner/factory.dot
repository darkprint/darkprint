// Attractor-compatible DOT, generated by DarkPrint (doc 1 §0.1.1).
// Blueprint digest: sha256:bdfb0b1d52638772a74cbb2a446fb827f057cc146c8600afcd8cee002739974b
digraph checkpoint_resume_runner {
  goal="A staged pipeline that snapshots state after every stage, so a failure at stage 3 resumes from the last good checkpoint instead of restarting the whole job.";
  label="Checkpoint & Resume Runner";

  __start [label="start", shape=Mdiamond];
  job [label="Job Intake", shape=parallelogram, prompt="Accept the incoming job submission and refuse it outright if its payload is larger than 512 KB, reporting the size you measured. Mint a run id for an accepted submission and copy the submitter's `job_id` onto it as the idempotency key: the checkpoint log is keyed on that value, so a resubmission carrying a `job_id` already in flight must return the run already open rather than starting a second one. Emit on `job` a single record holding the job's stated goal, the references to its payload and the run id you minted, and nothing beyond those three. You are done when that record is emitted — do not begin any of the work the job describes.", card="job-intake@1.0.0"];
  plan [label="Stage Planner", shape=box, prompt="Read the job record you are handed and break the work it describes into an ordered list of at most eight stages. Size each stage so it can be re-run on its own: give it its own inputs, its own exit condition and the checkpoint boundary that closes it, so a failure costs one stage of work instead of the whole run. Emit the ordered list on `stages`, carrying the run id through unchanged so every later stage and every checkpoint entry is written under the same run. You are done when every unit of work the job names belongs to exactly one stage and no stage depends on a stage that comes after it.", llm_model="claude-opus-5", card="stage-planner@1.0.0"];
  stage1 [label="Ingest Stage", shape=box, prompt="Execute the first stage of the plan you are handed and nothing further. Pull every source that stage names, 250 records to a batch, and abandon the stage if any single batch takes longer than 180 seconds; pull nothing the stage does not name, however relevant it looks. Record for each named source what you read from it and when, or that it was unreachable and why. Emit on `staged` the working set you assembled, that manifest, and the stages still to run, so the next stage picks up where you stopped. You are done when every source the stage names appears in the manifest under one of those two outcomes.", llm_model="claude-haiku-4-5", card="ingest-stage@1.0.0"];
  stage2 [label="Transform Stage", shape=box, prompt="You are handed a working set on `staged` on a first run, or a re-issued attempt on `restore` when a previous run of this stage failed and is being replayed; treat the two identically and prefer `restore` when both arrive. Apply the transformation the stage plan specifies to every record in that set, and abandon the stage if the work runs longer than 300 seconds rather than emitting a partial set. Emit on `transformed` the transformed set together with the diff against the input you started from, so the result can be replayed later without re-reading the sources. Be idempotent over your own output: run twice on the same input you must produce the same transformed set and the same diff, because a replayed attempt is exactly that.", llm_model="claude-sonnet-5", card="transform-stage@1.0.0"];
  stage3 [label="Assemble Stage", shape=box, prompt="Assemble the transformed working set you are handed into the single bundle the job asked for, and abandon the assembly rather than emit a half-built bundle if it runs longer than 240 seconds. Attach a stage-by-stage trace alongside it: for each part of the bundle, record which stage produced it and from which input, so the output and the path that produced it can be read together. Emit the bundle and its trace on `artifact`. You are done when every record in the transformed set is either present in the bundle or listed in the trace as deliberately dropped, with the reason it was dropped.", llm_model="claude-sonnet-5", card="assemble-stage@1.0.0"];
  checkpoint [label="Episodic Memory", shape=parallelogram, prompt="Append every event you are handed — a stage's inputs, its outputs and the decisions it took — to the episode log as one new entry, stamped with its run id and stage id. Entries are append-only: never rewrite or remove one, because the log is the record of what each stage actually did. When a recall query arrives, answer on `context` with the five nearest episodes scoring above 0.75 similarity; when no query arrives, answer with the five most recent instead. Keep thirty runs of history and let anything older fall off the back.", card="episodic-memory@1.0.0"];
  resume [label="Bounded Retry", shape=parallelogram, prompt="You may be handed a failure signal, a checkpoint snapshot, or both; either one on its own is enough to act on. With a checkpoint in hand, restore state from it as far as the last valid stage and re-fire that stage from the restored state; with only a failure signal, re-issue the attempt exactly as it stood. Wait 800 ms before the first retry and double the wait on every retry after it, emitting each re-issued attempt on `attempt` with its attempt number. Give up after three retries: emit the error from the final attempt on `last_error` and restore nothing further.", max_retries=3, card="bounded-retry@2.0.0"];
  verify [label="Acceptance Verifier", shape=box, prompt="Check the finished artefact you are handed against every criterion in the set registered as `acceptance-criteria@1`, one at a time, using the supporting material supplied alongside it wherever a criterion calls for evidence. Emit the artefact unchanged on `accepted` only once every criterion has cleared — nothing ships on a partial result, and a criterion you cannot evaluate has not cleared. There is no failure exit from this node: when a criterion is missed, record which one and stop the run there rather than passing the work anywhere.", llm_model="claude-sonnet-5", card="acceptance-verifier@1.0.0"];
  ship [label="Result Delivery", shape=parallelogram, prompt="Take the signed-off result you are handed, write it to `run-artifacts` exactly as the verifier released it, and close the run. Write the decision trace alongside it — which node produced what, and what each one decided — so the delivery can be reconstructed later without re-running the line. Emit nothing onward: this is the last step of the run, so deliver only what you were actually handed and alter none of it.", card="result-delivery@1.0.0"];
  __exit [label="exit", shape=Msquare];

  __start -> job;
  job -> plan;
  plan -> stage1;
  stage1 -> stage2;
  stage2 -> stage3;
  stage3 -> verify;
  verify -> ship;
  stage1 -> checkpoint;
  stage2 -> checkpoint;
  checkpoint -> resume [label="on failure"];
  resume -> stage2 [label="restore"];
  ship -> __exit;
}
