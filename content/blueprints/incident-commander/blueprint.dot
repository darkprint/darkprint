digraph incident_commander {
  rankdir=LR;
  node [shape=box, style=rounded];

  ticket      [card="event-intake@1.0.0"];
  classify    [card="intent-router@1.1.0"];
  autoresolve [card="resolution-composer@1.0.0"];
  kb          [card="runbook-resolver@1.0.0"];
  qa          [card="blast-radius-check@1.0.0"];
  send        [card="runbook-executor@1.0.0"];
  escalate    [card="confidence-escalation@1.0.0"];

  ticket -> classify [in="event"];
  classify -> autoresolve [label="simple"];
  classify -> kb [label="lookup"];
  kb -> autoresolve;
  autoresolve -> qa;
  qa -> send     [label="confident"];
  qa -> escalate [label="low conf.", style=dashed, out="risk", in="verdict"];
}
