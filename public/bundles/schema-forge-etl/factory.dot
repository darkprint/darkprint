// Attractor-compatible DOT, generated by DarkPrint (doc 1 §0.1.1).
// Blueprint digest: sha256:3a6feedc1bcfea35562ac1dde9d0f2e37f12373316b07565d80d64669bd315f9
digraph schema_forge_etl {
  goal="Extracts, normalizes and schema-validates messy documents, repairing anything that fails validation before it ever reaches the store.";
  label="Schema Forge ETL";

  __start [label="start", shape=Mdiamond];
  raw [label="Document Intake", shape=parallelogram, prompt="Collect the source documents waiting in the intake location and open a run over them, in batches of at most 100 documents. For each document record three things — the origin path it came from, its full content, and a stable hash of that content — and emit the batch on `documents` as one entry per document. Use that hash as the document's identity for the rest of the run: bytes you have seen before must hash to the same value, because that is what lets a re-run land on the record already written instead of a second copy of it. You are done when every document in the intake location appears in exactly one emitted batch.", card="document-intake@1.0.0"];
  extract [label="Field Extractor", shape=box, prompt="For every entry on `documents`, read the document's content and pull out the target fields named in the extraction schema you are configured with. Copy each value verbatim from the source text — do not paraphrase it, do not tidy it, do not convert a unit or a date format — and record next to it the span of the document the value was taken from, so a reviewer can check the extraction instead of trusting it. Emit one object per document on `fields`, keyed by field name and carrying that document's hash, so a later step can key back to the source. Where the document simply does not state a field, leave it absent: an absent field is a fact the next step can act on, and an invented one is a plausible record rather than a true one.", llm_model="claude-haiku-4-5", card="field-extractor@1.0.0"];
  normalize [label="Field Normalizer", shape=box, prompt="Take the field values arriving on `fields` — a JSON object per document or a row per delta, whichever form you are handed — and coerce them onto the canonical record shape: dates to ISO-8601, quantities to the canonical unit, enumerated values to their canonical casing, and every spelling of emptiness (`\"\"`, `-`, `N/A`, `unknown`) to a real null. Resolve ambiguous date and number formats as `en-GB`, so `03/04` is the third of April. Emit exactly one record per input row on `record`, carrying that row's identity through untouched; coerce values, and never invent one to fill a gap. A record arriving on `repaired` is one you have already seen, mended elsewhere: normalize it the same way and emit it the same way, but stop after a record has come back three times and drop it instead of sending it round again.", llm_model="claude-haiku-4-5", max_retries=3, card="field-normalizer@1.0.0"];
  validate [label="Schema Gate", shape=box, prompt="Check the normalized record you are handed against the schema registered as `schema-registry://forge-record@2`, and against any extra rules handed to you alongside it — cross-field invariants included. Emit the record byte-for-byte unchanged on `accepted` only when it clears both; a field the schema does not name is a failure, not a tolerance. Otherwise emit one entry per breach on `violations`, each naming the field and the specific constraint it broke, and stop at twenty-five entries so one unparseable batch cannot flood whatever repairs them.", llm_model="claude-haiku-4-5", card="schema-gate@1.1.0"];
  repair [label="Record Repairer", shape=box, prompt="Work through the entries on `violations` one at a time. Each entry names one field and the specific constraint that field broke, and that constraint is your whole brief for what the value has to become — rewrite that field and leave every other field of the record exactly as you received it. Emit the mended record on `repaired`, whole: never emit a partial record, and never delete a field or blank it out to make a violation go away, because a silently dropped field is worse than a rejected one. When a violation cannot be mended from what the record itself contains — the value is missing rather than malformed — leave the field alone and note the reason on the record, so the next pass fails on something true instead of on your guess.", llm_model="claude-sonnet-5", max_retries=3, card="record-repairer@1.0.0"];
  store [label="Record Store", shape=parallelogram, prompt="Upsert the records arriving on `records` into the target table in batches of at most 500 rows, matching an existing row on `record_id` and inserting when no row matches. Commit each batch before you start the next one, so an interruption leaves whole batches written rather than half of one. Emit a commit receipt on `stored` naming the keys written, how many rows were inserted against how many updated, and the boundary of the last batch that committed. You are done when every record handed to you appears in that receipt exactly once; if a batch fails to commit, stop there and report the boundary it failed at rather than skipping past it.", card="record-store@1.0.0"];
  publish [label="Dataset Publisher", shape=parallelogram, prompt="Read the commit receipt on `dataset` and cut it into a new immutable version of the `forge-records` dataset, tagged with the last batch boundary the receipt reports. Post one announcement to the `data-releases` channel naming that version, its row count and the schema reference the records were checked against. Cut the version before you announce it, and announce it exactly once — the channel has human subscribers and neither the published version nor the message can be recalled once it lands. The run closes when the channel has accepted the announcement; if the version cannot be cut, announce nothing and report the failure.", card="dataset-publisher@1.0.0"];
  __exit [label="exit", shape=Msquare];

  __start -> raw;
  raw -> extract;
  extract -> normalize;
  normalize -> validate;
  validate -> repair [label="invalid"];
  repair -> normalize;
  validate -> store [label="valid"];
  store -> publish;
  publish -> __exit;
}
