// Attractor-compatible DOT, generated by DarkPrint (doc 1 §0.1.1).
// Blueprint digest: sha256:22650d903612e521952d737a11e9659da3df5c7d958c1b0301c4408c2aee804f
digraph grounded_research_desk {
  goal="Fans a question across web, vector and code search, synthesizes one answer, and loops back through a fact-checker until every claim is grounded.";
  label="Grounded Research Desk";

  __start [label="start", shape=Mdiamond];
  question [label="Question Intake", shape=parallelogram, prompt="Take the oldest unhandled message from the `research-desk-inbox` source and turn it into one research question. Keep the asker's own wording for the ask itself, drop greetings, signatures and quoted reply chains, then append the scope they stated — date range, sources to prefer or avoid, and the deadline — as a short `Scope:` line beneath the question. Trim the result to at most 2000 characters, cutting at a sentence boundary rather than mid-word, and emit it as plain text on `question`. If the message carries more than one ask, keep the first and list the others verbatim under `Also asked:`; if it carries nothing that can be researched, emit nothing and end the run. You are done the moment one question with its scope has been emitted — do not answer it, rank it, or retrieve anything.", card="question-intake@1.0.0"];
  plan [label="Retrieval Planner", shape=box, prompt="You are handed one research question on `question`, with the asker's scope appended to it. Split it into at most three retrieval strands, one for each corpus that could hold an answer: the public web, the internal vector store, and the indexed code repositories. Write every strand as a standalone query plan — the search terms, the filters that follow from the stated scope, and how many results that strand should return — worded so whoever runs it needs nothing but that plan. Do not chain the strands: none of them may be phrased in terms of what another is expected to find, because they run at the same time and any of them may come back empty. Emit all the plans together on `strands`; you are done when every corpus that could hold an answer has exactly one plan and none has two.", llm_model="claude-opus-5", card="retrieval-planner@1.0.0"];
  web [label="Web Retriever", shape=parallelogram, prompt="Run the web strand of the retrieval plan you are given on `query`: issue its search terms with its site filters applied, keep the top eight results, and fetch each of those pages, following redirects. Emit one record per page you actually retrieved on `passages`, carrying the extracted body text, the final URL after redirects, the ISO-8601 timestamp of the fetch, and the rank the result held in the search listing. Give up on any single fetch that has not answered within twenty seconds and move to the next result rather than retrying it. Do not summarise, rank for truth, or drop a page because you disbelieve it — hand back what was served, so that whatever reads these passages can still tell retrieved text from established fact. You are done when every result you were able to fetch has a record, or the eight-result budget is exhausted.", card="web-retriever@1.0.0"];
  vectors [label="Vector Recall", shape=parallelogram, prompt="Embed the query in the internal-corpus strand you are given on `query`, apply that strand's filters, and retrieve the twelve nearest passages from the vector store, discarding any whose cosine similarity falls below 0.7. Emit them on `passages`, nearest first, each carrying its stored text, its document id and its similarity score, so a reader downstream can weigh a close match against a distant one. Read only: never embed or write this run's own text back into the store. If fewer than twelve passages clear the threshold, emit the ones that do and stop — padding the budget with weaker matches is worse than returning less.", card="vector-recall@1.0.0"];
  code [label="Code Index Search", shape=parallelogram, prompt="Search the indexed repositories for the symbols, paths and language filters named in the code strand you are given on `query`, and keep at most twenty hits. Emit each hit on `passages` as a snippet with six lines of context either side of the match, pinned to its repository, file path, line range and the commit sha the file was read at. Include matches under test directories: a test is often the clearest statement of what the code is meant to do. Check nothing out, run nothing, and write nothing back — the index is read-only, and the commit sha is what keeps a hit resolvable after the branch has moved on. You are done when every match you kept carries all five of those coordinates.", card="code-index-search@1.0.0"];
  synth [label="Evidence Synthesizer", shape=box, prompt="You receive on `passages` one pool of retrieved text, fanned in from several corpora, where each entry carries its own identifier — a URL, a document id, or a repository path and commit. Write a single continuous answer to the research question drawing only on that pool, and attach an inline citation to the identifier of the specific entry behind every sentence that asserts something; if the pool will not carry a statement, leave the statement out rather than hedging it into the text. Emit the finished answer on `draft`. On a second entry you will also receive `gaps`, which names individual claims from your previous draft and what was found wrong with each — rewrite exactly those claims against the same pool and leave every other sentence of the draft untouched. You are done when every asserted sentence in `draft` carries a citation into the pool and nothing named in `gaps` has been left as it was.", llm_model="claude-opus-5", card="evidence-synthesizer@1.0.0"];
  factcheck [label="Claim Verifier", shape=box, prompt="For each asserted sentence in the document on `draft`, open the source its citation points at and decide one thing only: whether that source, read on its own, carries that sentence. Do not weigh how plausible the sentence is, and do not go looking for a different source that would rescue it. Emit on `grounded` the same document reduced to the sentences that survived, their citations untouched. Emit on `gaps` one entry per sentence that failed, quoting the sentence and stating exactly why it failed — the source says something narrower, the source contradicts it, the source does not mention it, or there was no citation at all. Never edit a sentence to make it pass and never supply a citation of your own; your output is a verdict with the evidence behind it, and the rewriting belongs to someone else. After the third pass over the same document, release whatever is grounded and carry the outstanding gaps into the report as stated gaps rather than sending it round again.", llm_model="claude-opus-5", max_retries=3, card="claim-verifier@1.0.0"];
  report [label="Report Delivery", shape=parallelogram, prompt="Publish the verified document on `report` to the `research-desk` destination, addressed to the person whose question opened the run. Carry the citation trail across unchanged: every sentence keeps the inline citation it arrived with, and the reference list keeps each source's identifier — URL, document id, or repository path and commit sha — together with the time it was retrieved, so a reader can walk any sentence back to the text behind it. Do not reorder, reword, shorten or reformat the content; you are delivering a verified artefact, not editing one. Publish exactly once, and only after the whole document and its reference list have arrived — once it has gone out it cannot be recalled or amended, so an incomplete input is a reason to stop, not to send a partial report.", card="report-delivery@1.0.0"];
  __exit [label="exit", shape=Msquare];

  __start -> question;
  question -> plan;
  plan -> web;
  plan -> vectors;
  plan -> code;
  web -> synth;
  vectors -> synth;
  code -> synth;
  synth -> factcheck;
  factcheck -> synth [label="unsupported"];
  factcheck -> report [label="grounded"];
  report -> __exit;
}
