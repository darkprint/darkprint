// Attractor-compatible DOT, generated by DarkPrint (doc 1 §0.1.1).
// Blueprint digest: sha256:a4c9d09c6acdb62d082cd870546eb2dc4d9564435e0a91b0f1d9467f81a108d1
digraph frontline_triage {
  goal="Classifies inbound tickets, auto-resolves the simple ones with a KB lookup, QAs its own reply, and escalates only when confidence drops.";
  label="Frontline Triage";

  __start [label="start", shape=Mdiamond];
  ticket [label="Event Intake", shape=parallelogram, prompt="Take the raw payload the ticket queue or the alert bus handed you and turn it into exactly one event record. Attach a correlation id that will stay with this item for the rest of the run, record which source it arrived on and the time it arrived, and leave the payload itself untouched, you normalise the envelope, never the contents. Compare the record against the ones you admitted in the last 120 seconds and admit nothing that repeats one of them: a duplicate is dropped here and emitted nowhere. Emit the admitted record on `event`, and treat yourself as done when either one record has gone out or the item has been dropped as a repeat.", card="event-intake@1.0.0"];
  classify [label="Intent Router", shape=diamond, prompt="Read the inbound event as it arrived and decide which one of `billing`, `bug-report`, `how-to` or `account-access` it is. Emit the lane you picked on `lane` with the confidence you had in it, and emit the event on `routed` with its label added and payload and metadata otherwise untouched. If your confidence in the best label is below 0.6, route to the `general` lane instead of committing to a guess, every event leaves this node down some lane, because anything unrouted falls on the floor.", card="intent-router@1.0.0"];
  autoresolve [label="Resolution Composer", shape=box, prompt="Read the routed request on `request` and write one candidate resolution for it. When a reference document arrives on `reference`, ground every factual claim you make in that document and name the passage each claim came from; when nothing arrives on `reference`, say in the draft which claims are unsupported instead of filling the gap from memory. Emit the draft on `draft` together with its citations and a confidence figure between 0 and 1 that reflects how well the reference actually covered the request, not how well the prose reads. Do not present the draft as approved, sent or applied, and do not act on it yourself, you are done the moment the draft, its citations and that figure are on `draft`.", llm_model="claude-sonnet-5", card="resolution-composer@1.0.0"];
  kb [label="KB Resolver", shape=parallelogram, prompt="Build a retrieval query out of the routed request on `query`, its label plus the body of the message it carries, and pull the four nearest knowledge-base articles for it. Throw away every hit that scores below 0.35, then emit the single best of what survives on `article`, verbatim, with its article id and its last-reviewed date in the front matter. Do not paraphrase, merge, translate or summarise the article: the node that reads it quotes it, so any edit you make is an edit to a quotation. If nothing clears 0.35, emit nothing at all rather than the least-bad article in the index, an empty result is the correct answer here and the run is built to survive it.", card="kb-resolver@1.0.0"];
  qa [label="Reply QA Check", shape=box, prompt="Read the drafted reply and the citations attached to it on `draft`, and grade it against the `support-reply-rubric@2` rubric on three axes: tone, factual accuracy and completeness. Check every factual claim in the reply against the citation the draft says supports it, and score an uncited or mis-cited claim as an accuracy failure rather than as a style note. Emit the graded score on `confidence` as a single number between 0 and 1, and put the reply on `approved`, unchanged apart from your QA stamp, only when that score is 0.72 or above. The customer's personal details ride inside the draft: leave them there, and do not copy names, addresses, order numbers or account identifiers into the score or into any comment you attach to it. You are done when a score is on `confidence` and `approved` carries either the stamped reply or nothing at all.", llm_model="claude-sonnet-5", card="reply-qa-check@1.0.0"];
  send [label="Reply Dispatch", shape=parallelogram, prompt="Post the reply you are handed on `approved` to the ticket thread named inside it, over the channel that thread arrived on and over no other. Send it exactly as it reached you: you are not authorised to edit, shorten, re-tone or append to a reply that has already been cleared. Send it exactly once, a sent message cannot be recalled, so if the provider has not answered within fifteen seconds, report the timeout and stop rather than sending again. Emit the provider's acknowledgement on `receipt` in the provider's own terms, delivered, deferred or rejected, and never upgrade a deferral or a rejection into a success. You are done when a receipt is on `receipt`, whatever that receipt says.", card="reply-dispatch@1.0.0"];
  escalate [label="Confidence Escalation", shape=hexagon, prompt="Read the confidence figure on the verdict you are handed. At 0.7 or above, pass the work through on `accepted` exactly as it reached you and take no other action. Below 0.7, decide nothing yourself: assemble the parked case on `escalated` with the work that was graded attached, taken from the context you were given, or pulled from the run record when none was wired, put a fifteen-minute deadline on it, notify the reviewer on call, and wait. Nothing reaches `accepted` that has not either cleared 0.7 or been approved by that person.", card="confidence-escalation@1.0.0"];
  __exit [label="exit", shape=Msquare];

  __start -> ticket;
  ticket -> classify;
  classify -> autoresolve [label="simple"];
  classify -> kb [label="lookup"];
  kb -> autoresolve;
  autoresolve -> qa;
  qa -> send [label="confident"];
  qa -> escalate [label="low conf."];
  send -> __exit;
  escalate -> __exit;
}
