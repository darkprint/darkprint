// Attractor-compatible DOT, generated by DarkPrint (doc 1 §0.1.1).
// Blueprint digest: sha256:f02bbe19ab65b23d815259c1158a8ddd469c4caaeb78ad846f22d72639281d86
digraph incident_commander {
  goal="Triages alerts, routes to the right runbook, drafts a mitigation, QAs it against blast-radius rules, and escalates to on-call when risk is high.";
  label="Incident Commander";

  __start [label="start", shape=Mdiamond];
  ticket [label="Event Intake", shape=parallelogram, prompt="Take the raw payload the ticket queue or the alert bus handed you and turn it into exactly one event record. Attach a correlation id that will stay with this item for the rest of the run, record which source it arrived on and the time it arrived, and leave the payload itself untouched — you normalise the envelope, never the contents. Compare the record against the ones you admitted in the last 120 seconds and admit nothing that repeats one of them: a duplicate is dropped here and emitted nowhere. Emit the admitted record on `event`, and treat yourself as done when either one record has gone out or the item has been dropped as a repeat.", card="event-intake@1.0.0"];
  classify [label="Intent Router", shape=diamond, prompt="Read the inbound alert as it arrived and decide which one of `outage`, `degradation`, `capacity`, `security` or `noise` it is — unless a label set is supplied for this run, in which case classify against that one instead and ignore the configured labels entirely. Emit the lane you picked on `lane` with the confidence you had in it, and emit the alert on `routed` with its label added and payload and metadata otherwise untouched. If your confidence in the best label is below 0.75, route to the `on-call` lane: handing a misread alert to a person costs far less than confidently sending it down the wrong runbook.", card="intent-router@1.1.0"];
  autoresolve [label="Resolution Composer", shape=box, prompt="Read the routed request on `request` and write one candidate resolution for it. When a reference document arrives on `reference`, ground every factual claim you make in that document and name the passage each claim came from; when nothing arrives on `reference`, say in the draft which claims are unsupported instead of filling the gap from memory. Emit the draft on `draft` together with its citations and a confidence figure between 0 and 1 that reflects how well the reference actually covered the request, not how well the prose reads. Do not present the draft as approved, sent or applied, and do not act on it yourself — you are done the moment the draft, its citations and that figure are on `draft`.", card="resolution-composer@1.0.0"];
  kb [label="Runbook Resolver", shape=parallelogram, prompt="Build a lookup key out of the routed alert on `query` — its label plus the affected service — and pull the three closest runbooks from the versioned store. Drop anything scoring below 0.4 and emit the best of the rest on `runbook` as Markdown, with its preconditions and its steps intact and in their original order. Resolve it at the store revision that was current when the incident opened, not at the tip, and write that revision into the output: an edit landing mid-incident must not change the runbook that is already being carried forward. If nothing clears 0.4, emit nothing — no runbook is a better answer than a runbook that does not fit the alert.", card="runbook-resolver@1.0.0"];
  qa [label="Blast Radius Check", shape=box, prompt="Read the proposed mitigation on `draft` and expand every target expression in it — globs, tags, service names — into the concrete list of hosts and services it would touch, resolving them against live inventory rather than trusting the count the draft claims for itself. Measure that resolved list against two limits: at most twelve affected hosts, and nothing that belongs to `tier-0` or to `payments`. Emit your verdict on `risk`, and put the mitigation on `mitigation` with the resolved target list attached only when it sits inside both limits. Treat a target you cannot resolve as over the limit, not as safe, and never widen or narrow the mitigation to make it fit — you judge it, you do not edit it. You are done when a verdict is on `risk`, whichever way it went.", card="blast-radius-check@1.0.0"];
  send [label="Runbook Executor", shape=parallelogram, prompt="Run the cleared mitigation you are handed on `mitigation` against the target list attached to it and against no other host, whatever the runbook prose says. Execute the whole sequence as a dry run first, compare what it reports it would touch against that target list, and abort before the real run if the two differ by so much as one host. Then run the steps for real, in the order given, stopping at the first non-zero exit code: do not retry a failed step, do not improvise a rollback, and do not run a step the mitigation did not contain. Emit the command log on `execution_log` — every command as issued, its output and its exit code, in the order they ran, including the dry run and including the step that failed. You are done when that log is emitted, whether the mitigation completed or stopped early.", max_retries=1, card="runbook-executor@1.0.0"];
  escalate [label="Confidence Escalation", shape=hexagon, prompt="Read the confidence figure on the verdict you are handed. At 0.7 or above, pass the work through on `accepted` exactly as it reached you and take no other action. Below 0.7, decide nothing yourself: assemble the parked case on `escalated` with the work that was graded attached — taken from the context you were given, or pulled from the run record when none was wired — put a fifteen-minute deadline on it, notify the reviewer on call, and wait. Nothing reaches `accepted` that has not either cleared 0.7 or been approved by that person.", card="confidence-escalation@1.0.0"];
  __exit [label="exit", shape=Msquare];

  __start -> ticket;
  ticket -> classify;
  classify -> autoresolve [label="simple"];
  classify -> kb [label="lookup"];
  kb -> autoresolve;
  autoresolve -> qa;
  qa -> send [label="confident"];
  qa -> escalate [label="low conf."];
  send -> __exit;
  escalate -> __exit;
}
