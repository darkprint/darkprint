digraph schema_forge_etl {
  rankdir=LR;
  node [shape=box, style=rounded];

  raw       [card="document-intake@1.0.0"];
  extract   [card="field-extractor@1.0.0"];
  normalize [card="field-normalizer@1.1.0"];
  validate  [card="schema-gate@1.1.0"];
  repair    [card="record-repairer@1.1.0"];
  store     [card="record-store@1.0.0"];
  publish   [card="dataset-publisher@1.0.0"];

  raw -> extract;
  extract -> normalize [in="fields"];
  normalize -> validate [in="candidate"];

  // The same fork and the same guard as `nightly-data-janitor`, and it was broken the same
  // way: with no condition on either edge, engine spec §3.3 reached step 5 and `repair`
  // won the lexical tiebreak against `store`, so a document that cleared the gate was sent
  // to be repaired anyway. `outcome` is the gate's own verdict, and one key against its
  // negation is the total pair §10's grammar allows, with `partial_success` on the repair
  // side because a partly-cleared record still breaches the schema somewhere.
  validate -> repair [label="invalid", style=dashed, out="violations", in="violations", condition="outcome!=success"];
  repair -> normalize [in="repaired"];
  validate -> store [label="valid", out="accepted", condition="outcome=success"];
  store -> publish;
}
