// Attractor-compatible DOT, generated by DarkPrint (doc 1 §0.1.1).
// Blueprint digest: sha256:8fecbcf33655c9164565291d2c26dfaad1d492d7905adc7f081ea7632b4e5c81
digraph starter_software_factory {
  goal="The canonical five-node factory — plan, build, test, debug, release — and the one edge it deliberately does not have: nothing carries the acceptance criteria to the builder.";
  label="Starter Software Factory";

  __start [label="start", shape=Mdiamond];
  planner [label="Spec Planner", shape=box, prompt="Read the feature request you are handed and turn it into two separate artefacts, written independently of one another. On `plan`, set out the ordered steps someone would follow to build the thing, naming for each step the file or module it touches and what exists once it is done. On `criteria`, set out the conditions the finished work must satisfy, one per line, each phrased so a machine can decide it: an observable behaviour, an input paired with the output it must produce, or a measurable limit. Keep the two apart — a step is not a criterion, and a criterion that merely restates a step tests nothing. Write no code yourself, and never weaken a criterion to make it easier to meet.", card="spec-planner@1.0.0"];
  builder [label="Code Builder", shape=box, prompt="A build brief arrives with the run: an ordered list of steps, each naming the file or module it touches and what should exist once it is done. Work through the steps in order and write the source they describe, staying inside the files each step names and adding no behaviour nobody asked for. Emit the finished source on `build` as one complete, compiling change, with no commentary and no summary of what you did. The brief is all you get, and that is the point — do not go looking for a test suite, do not reason about how the result will be checked, and do not tune anything toward a check you imagine exists.", card="code-builder@1.0.0"];
  tester [label="Acceptance Tester", shape=box, prompt="You are handed a set of criteria and a build. Run each criterion against that build in turn, one at a time, and record whether it held. When every one of them holds, emit the build unchanged on `approved` and emit nothing on `evidence`. When any of them does not, emit on `evidence` only what the run itself produced — the assertion that failed, the stack trace underneath it, and the expected value beside the value actually obtained — and nothing else: do not quote the criterion, do not summarise the ones still outstanding, and do not say how many there are in total. A criterion you were unable to evaluate has not held.", card="acceptance-tester@1.0.0"];
  debugger [label="Targeted Debugger", shape=box, prompt="You are given the evidence from a run that failed: the assertions that did not hold, the stack traces underneath them, and the expected value beside the one actually obtained. Find the smallest change to the existing source that accounts for those failures and emit it on `patch` — a patch, not a rewrite, leaving every part of the code the evidence does not implicate exactly as it is. Do not special-case the literal values in the trace: a change that satisfies only the example in front of you has fixed nothing, and it will come straight back. Stop after three attempts, and stop earlier if two consecutive runs hand you the same evidence — that means you are circling, and another pass costs a round without buying information.", max_retries=3, card="targeted-debugger@1.0.0"];
  deployer [label="Release Gate", shape=parallelogram, prompt="A build reaches you only once it has been signed off, and your first job is to check that: anything arriving without the sign-off is refused and the run ends there, unreleased. For a build that carries it, write the artefact byte-for-byte as you received it to the release target named in the run configuration, under a tag made from the run id, and record the digest of exactly what you wrote beside it. Alter nothing on the way through — no reformatting, no last-minute fix, no substitution of a build you think is better. Emit nothing onward: this is the end of the run, and the tag plus the digest are the whole of what it leaves behind.", card="release-gate@1.0.0"];
  __exit [label="exit", shape=Msquare];

  __start -> planner;
  __start -> builder;
  planner -> tester [label="acceptance criteria"];
  builder -> tester [label="build"];
  tester -> debugger [label="failure evidence"];
  debugger -> tester [label="patch"];
  tester -> deployer [label="approved build"];
  deployer -> __exit;
}
