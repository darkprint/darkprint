# Copy to .env.local for `npm run dev`, or export directly for `npm test`.
# Matches the services `compose.yaml` brings up with `docker compose up -d`.

# Postgres holds the index (B-01). Same connection string shape either local or hosted.
DATABASE_URL=postgres://darkprint:darkprint@localhost:5432/darkprint

# S3-compatible object storage holds bytes, keyed by digest (B-01). MinIO locally,
# any S3-compatible host in production — the client only needs the endpoint to change.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=darkprint
S3_ACCESS_KEY_ID=darkprint
S3_SECRET_ACCESS_KEY=darkprint123

# GitHub OAuth app credentials (B-02). Nobody has these yet: the login/callback routes
# read them and fail closed when absent, but the session guard itself needs no GitHub
# credential to return 401 for an absent session.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# HMAC key signing the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
